# {{ ansible_managed }}
[Unit]
Description=red_pass seal-agent secret-id rotation
After=network-online.target vault-agent.service

[Service]
Type=oneshot
User={{ agent_user }}
Group={{ agent_user }}
ExecStart=/usr/local/libexec/red-pass-seal-rotate
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths={{ agent_conf_dir }}
ReadWritePaths={{ agent_state_dir }}
