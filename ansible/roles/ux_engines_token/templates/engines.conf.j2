# {{ ansible_managed }} — ux_engines_token
# Engines page: Vault reads port, namespace, and the path of the read-only
# token (its contents never appear in the unit or the environment).
[Service]
Environment=RED_PASS_VAULT_ADDR={{ ux_engines_vault_addr }}
Environment=RED_PASS_ENGINES_NAMESPACE={{ ux_engines_namespace }}
Environment=RED_PASS_ENGINES_TOKEN_FILE={{ ux_conf_dir }}/engines-token
